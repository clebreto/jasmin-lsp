(rule
 (targets libtree-sitter-jasmin.a libtree-sitter-jasmin.so libtree-sitter-jasmin.dylib)
 (deps (source_tree %{project_root}/tree-sitter-jasmin))
 (action
  (progn
   (run cp %{project_root}/tree-sitter-jasmin/libtree-sitter-jasmin.a libtree-sitter-jasmin.a)
   (bash "cp %{project_root}/tree-sitter-jasmin/libtree-sitter-jasmin.so libtree-sitter-jasmin.so 2>/dev/null || touch libtree-sitter-jasmin.so")
   (bash "cp %{project_root}/tree-sitter-jasmin/libtree-sitter-jasmin.dylib libtree-sitter-jasmin.dylib 2>/dev/null || touch libtree-sitter-jasmin.dylib"))))

(executable
 (name jasmin_lsp)
 (public_name jasmin-lsp)
 (flags (:standard -w -27-32 -g))
 (link_flags
   -cclib jasmin-lsp/libtree-sitter-jasmin.a
   -cclib %{env:CONDA_PREFIX=/usr/local}/lib/libtree-sitter.a
   -cclib -Wl,-rpath,%{env:CONDA_PREFIX=/usr/local}/lib
   -cclib -Wl,-rpath,$ORIGIN
   -cclib -Wl,-rpath,@loader_path)
 (foreign_stubs
  (language c)
  (names tree_sitter_stubs)
  (flags -I%{env:CONDA_PREFIX=/usr/local}/include
         -I%{project_root}/tree-sitter-jasmin/src
         -I%{project_root}/tree-sitter-jasmin/bindings/c))
 (libraries jasmin.jasmin lsp yojson lwt lwt.unix cmdliner batteries ppx_yojson_conv_lib)
 (preprocess
   (pps ppx_yojson_conv lwt_ppx)
 )
)

(include_subdirs qualified)